{
  "name": "receipt-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "sync-categories": "node tools/sync_category_data.mjs",
    "deploy-functions": "npm run sync-categories && npx supabase functions deploy parse-receipt --use-api",
    "dictionary": "python tools/build_print_dictionary.py --check && python tools/build_print_dictionary.py",
    "dictionary:deploy": "python tools/build_print_dictionary.py && npm run deploy-functions",
    "import-json": "node tools/import_json.mjs",
    "import-json:done": "node tools/import_json.mjs --done",
    "fix-stores": "node tools/fix_store_names.mjs --from-db",
    "fix-products": "node tools/fix_midonly_items.mjs",
    "db": "node tools/db_query.mjs",
    "manual": "python tools/export_manual.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "vite": "^8.3.4"
  }
}
