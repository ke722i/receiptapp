# テスト項目書の Excel（結果を書き込む手元のファイル。tools/export_test_items.py でいつでも作れるので、リポジトリには入れない）
TEST_ITEMS.xlsx

# Excel が、ファイルを開いている間だけ作る一時ファイル（ロックファイル）
~$*

# 手元の整理用（使っていないファイル・古い作業ファイル・作り直せる Excel など）。Git には入れない
misc/

# SVG の軽量化前の控え（docs/icons.md）
tools/svg_original/

# Gemini のチャット用の指示文（tools/export_gemini_prompt.mjs で作る）
tools/gemini_chat_prompt.txt

# Gemini のチャットで作ったレシートの JSON（個人のデータ。Git に入れない）
tools/receipt_json/*
!tools/receipt_json/.gitkeep

# 提案の反映の前の Excel の控え（tools/apply_proposals.py）
tools/categoryTable.backup.xlsx
tools/proposals/*
!tools/proposals/.gitkeep

# 分類の間違いの記録（購入日・店名が入っているので、Git に入れない。辞書は、ここから作った printNameDictionary.js を入れる）
tools/wrongCategory.xlsx

# 読み取り専用の DB 接続（パスワードを含む。Git に入れない。Claude は開かない。tools/db_query.mjs だけが読む）
.db-readonly.url
tools/dictionary_candidates.xlsx
.import-uid
マニュアル.xlsx
~$マニュアル.xlsx
